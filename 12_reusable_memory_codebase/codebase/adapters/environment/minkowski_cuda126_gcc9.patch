+++ b/src/coordinate_map_gpu.cuh
@@ -136,9 +136,13 @@ public:
       LOG_DEBUG("Reserve map of",
                 compute_hash_table_size(size, m_hashtable_occupancy),
                 "for concurrent_unordered_map of size", size);
-      m_map = map_type::create(
+      auto new_map = map_type::create(
